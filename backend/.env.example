# RAKSHAK AI — Backend environment variables
# Copy this file to `.env` and fill in real values for your own deployment.
# Every value below is safe to commit — no real secrets belong in this file
# or in `.env` itself (which is gitignored).

SECRET_KEY=replace-with-a-real-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Blank = SQLite (auto-created at backend/db.sqlite3).
# Set to a Postgres URL for production, e.g.:
#   postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Redis powers inter-agent pub/sub. Agents fall back gracefully if unreachable.
REDIS_URL=redis://localhost:6379

# IoT / Camera identity used by the demo simulation scripts
TRUCK_ID=TRK-001

# ─── SMTP Email (Alert notifications) ────────────────────────────────────────
# Leave blank to suppress email sending (alerts still get logged + created).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ─── Twilio SMS (Alert notifications) ────────────────────────────────────────
# Leave blank to suppress SMS sending (demo mode).
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# ─── Explainability Agent (LLM) ──────────────────────────────────────────────
# LLM_PROVIDER: template | openai | ollama
# "template" (default) needs no API key and produces deterministic, rule-based
# explanations — recommended for local dev / demos.
LLM_PROVIDER=template
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
