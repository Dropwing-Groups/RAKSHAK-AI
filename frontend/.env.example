# RAKSHAK AI — Frontend environment variables
# Copy this file to `.env.local` and adjust for your setup.

# Points the Next.js app at the local Django backend.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Set to "true" to skip the backend entirely and use hardcoded seed data.
# Useful for pure UI development without a running backend.
NEXT_PUBLIC_USE_MOCK=false

# Optional — enables the Google Maps view (GoogleMapComponent). Leave blank
# to fall back to the built-in Leaflet/SVG map.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
